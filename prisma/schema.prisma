generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String           @id @default(uuid())
  username            String           @unique
  email               String           @unique
  passwordHash        String
  status              String           @default("ACTIVE")
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  resetOtpCode        String?          @db.VarChar(6)
  resetOtpExpiresAt   DateTime?
  phone               String?
  blocksReceived      Block[]          @relation("BlockBlockedUser")
  blocksSent          Block[]          @relation("BlockUser")
  following           Follow[]         @relation("UserFollowing")
  followers           Follow[]         @relation("UserFollowers")
  friendshipsAsFriend Friendship[]     @relation("FriendshipFriend")
  friendRequestsSent  Friendship[]     @relation("FriendshipRequester")
  friendshipsAsUser   Friendship[]     @relation("FriendshipUser")
  posts               Post[]
  profile             Profile?
  profileSettings     ProfileSettings?
  socialLinks         UserSocialLink[]
}

model PendingUser {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String
  passwordHash String
  otpCode      String   @db.VarChar(6)
  createdAt    DateTime @default(now())
}

model Profile {
  id                     String           @id @default(uuid())
  userId                 String           @unique
  displayName            String
  bio                    String?
  avatarUrl              String?
  coverUrl               String?
  birthDate              DateTime?
  community              String?
  createdAt              DateTime         @default(now())
  gender                 String?
  groupChat              String?
  locationId             String?
  socialMedia            String?
  type                   ProfileType      @default(PERSONAL)
  updatedAt              DateTime         @default(now()) @updatedAt
  websiteUrl             String?
  displayNameChangeDates DateTime[]       @default(dbgenerated("(ARRAY[]::timestamp without time zone[])::timestamp(3) without time zone[]"))
  education              String?
  locationName           String?
  profession             String?
  externalLinks          Json?            @default("[]")
  games                  String[]         @default([])
  hardSkills             String[]         @default([])
  hobbies                String[]         @default([])
  movies                 String[]         @default([])
  music                  String[]         @default([])
  softSkills             String[]         @default([])
  softwareSkills         String[]         @default([])
  sports                 String[]         @default([])
  tvShows                String[]         @default([])
  location               Location?        @relation(fields: [locationId], references: [id])
  user                   User             @relation(fields: [userId], references: [id], onDelete: Cascade)

}

model ProfileSettings {
  userId             String            @id
  profileVisibility  ProfileVisibility @default(PUBLIC)
  showBirthDate      Boolean           @default(true)
  showLocation       Boolean           @default(true)
  allowFollow        Boolean           @default(true)
  allowFriendRequest Boolean           @default(true)
  searchable         Boolean           @default(true)
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSocialLink {
  id           String @id @default(uuid())
  userId       String
  platform     String
  url          String
  displayOrder Int    @default(0)
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Location {
  id       String    @id @default(uuid())
  country  String
  province String
  city     String
  district String?
  profiles Profile[]
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model Friendship {
  id          String           @id @default(uuid())
  userId      String
  friendId    String
  requestedBy String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  acceptedAt  DateTime?
  friend      User             @relation("FriendshipFriend", fields: [friendId], references: [id], onDelete: Cascade)
  requester   User             @relation("FriendshipRequester", fields: [requestedBy], references: [id], onDelete: Cascade)
  user        User             @relation("FriendshipUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
}

model Block {
  id            String   @id @default(uuid())
  userId        String
  blockedUserId String
  createdAt     DateTime @default(now())
  blockedUser   User     @relation("BlockBlockedUser", fields: [blockedUserId], references: [id], onDelete: Cascade)
  user          User     @relation("BlockUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, blockedUserId])
}

model Post {
  id        String   @id @default(uuid())
  content   String
  type      PostType @default(NORMAL)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
}



enum ProfileType {
  PERSONAL
  BUSINESS
}

enum ProfileVisibility {
  PUBLIC
  FRIENDS
  PRIVATE
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
}

enum PostType {
  NORMAL
  SEARCHING
  OFFERING
  QUESTION
  POLL
  ANNOUNCEMENT
}
