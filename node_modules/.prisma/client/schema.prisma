generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String           @id @default(uuid())
  username              String           @unique
  email                 String           @unique
  passwordHash          String
  status                String           @default("ACTIVE")
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  resetOtpCode          String?          @db.VarChar(6)
  resetOtpExpiresAt     DateTime?
  phone                 String?
  blocksReceived        Block[]          @relation("BlockBlockedUser")
  blocksSent            Block[]          @relation("BlockUser")
  following             Follow[]         @relation("UserFollowing")
  followers             Follow[]         @relation("UserFollowers")
  friendshipsAsFriend   Friendship[]     @relation("FriendshipFriend")
  friendRequestsSent    Friendship[]     @relation("FriendshipRequester")
  friendshipsAsUser     Friendship[]     @relation("FriendshipUser")
  posts                 Post[]
  profile               Profile?
  profileSettings       ProfileSettings?
  socialLinks           UserSocialLink[]
  notificationsReceived Notification[]   @relation("NotificationRecipient")
  notificationsSent     Notification[]   @relation("NotificationSender")
  comments              Comment[]
  likes                 Like[]
  savedPosts            SavedPost[]
}

model PendingUser {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String
  passwordHash String
  otpCode      String   @db.VarChar(6)
  createdAt    DateTime @default(now())
}

model Profile {
  id                     String      @id @default(uuid())
  userId                 String      @unique
  displayName            String
  bio                    String?
  avatarUrl              String?
  coverUrl               String?
  birthDate              DateTime?
  community              String?
  createdAt              DateTime    @default(now())
  gender                 String?
  groupChat              String?
  locationId             String?
  socialMedia            String?
  type                   ProfileType @default(PERSONAL)
  updatedAt              DateTime    @default(now()) @updatedAt
  websiteUrl             String?
  displayNameChangeDates DateTime[]  @default(dbgenerated("(ARRAY[]::timestamp without time zone[])::timestamp(3) without time zone[]"))
  education              String?
  locationName           String?
  profession             String?
  externalLinks          Json?       @default("[]")
  games                  String[]    @default([])
  hardSkills             String[]    @default([])
  hobbies                String[]    @default([])
  movies                 String[]    @default([])
  music                  String[]    @default([])
  softSkills             String[]    @default([])
  softwareSkills         String[]    @default([])
  sports                 String[]    @default([])
  tvShows                String[]    @default([])
  location               Location?   @relation(fields: [locationId], references: [id])
  user                   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProfileSettings {
  userId              String             @id
  profileVisibility   ProfileVisibility  @default(PUBLIC)
  privacyGender       ProfileVisibility  @default(PUBLIC)
  privacyBirth        ProfileVisibility  @default(PUBLIC)
  privacyLoc          ProfileVisibility  @default(PUBLIC)
  privacyProf         ProfileVisibility  @default(PUBLIC)
  privacySosmed       ProfileVisibility  @default(PUBLIC)
  privacyFriendList   ProfileVisibility  @default(PUBLIC)
  privacyFollowers    ProfileVisibility  @default(PUBLIC)
  privacyFollowing    ProfileVisibility  @default(PUBLIC)
  privacyActivity     ProfileVisibility  @default(PUBLIC)
  privacyOwnedGroups  ProfileVisibility  @default(PUBLIC)
  privacyJoinedGroups ProfileVisibility  @default(PUBLIC)
  privacyExternalLink ProfileVisibility  @default(PUBLIC)
  privacyTag          ProfileVisibility  @default(PUBLIC)
  privacyComment      InteractionPrivacy @default(PUBLIC)
  privacyOnline       InteractionPrivacy @default(PUBLIC)
  privacyDM           Boolean            @default(true)
  showBirthDate       Boolean            @default(true) // Deprecated: replaced by privacyBirth
  showLocation        Boolean            @default(true) // Deprecated: replaced by privacyLoc
  allowFollow         Boolean            @default(true)
  allowFriendRequest  Boolean            @default(true)
  searchable          Boolean            @default(true)
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSocialLink {
  id           String @id @default(uuid())
  userId       String
  platform     String
  url          String
  displayOrder Int    @default(0)
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Location {
  id       String    @id @default(uuid())
  country  String
  province String
  city     String
  district String?
  profiles Profile[]
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model Friendship {
  id          String           @id @default(uuid())
  userId      String
  friendId    String
  requestedBy String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  acceptedAt  DateTime?
  friend      User             @relation("FriendshipFriend", fields: [friendId], references: [id], onDelete: Cascade)
  requester   User             @relation("FriendshipRequester", fields: [requestedBy], references: [id], onDelete: Cascade)
  user        User             @relation("FriendshipUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
}

model Block {
  id            String   @id @default(uuid())
  userId        String
  blockedUserId String
  createdAt     DateTime @default(now())
  blockedUser   User     @relation("BlockBlockedUser", fields: [blockedUserId], references: [id], onDelete: Cascade)
  user          User     @relation("BlockUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, blockedUserId])
}

model Post {
  id           String         @id @default(uuid())
  content      String
  mediaUrls    String[]       @default([])
  type         PostType       @default(NORMAL)
  visibility   PostVisibility @default(PUBLIC)
  label        PostLabel      @default(DEFAULT)
  authorId     String
  communityId  String? // Prepared for community phase
  sharedPostId String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  sharedPost    Post?          @relation("PostShares", fields: [sharedPostId], references: [id], onDelete: SetNull)
  shares        Post[]         @relation("PostShares")
  comments      Comment[]
  likes         Like[]
  savedBy       SavedPost[]
  notifications Notification[]
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  postId    String
  authorId  String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post          Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent        Comment?       @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       Comment[]      @relation("CommentReplies")
  likes         Like[]
  notifications Notification[]
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  postId    String?
  commentId String?
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  // Ensure a user can only like a specific post or comment once
  @@unique([userId, postId, commentId])
}

model SavedPost {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model Notification {
  id     String           @id @default(uuid())
  type   NotificationType
  isRead Boolean          @default(false)

  // The user who receives the notification
  userId String
  user   User   @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  // The user who triggered the notification (optional)
  senderId String?
  sender   User?   @relation("NotificationSender", fields: [senderId], references: [id], onDelete: Cascade)

  // Optional relations to other entities (e.g. Post, Comment) when they exist
  postId String?
  post   Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)

  commentId String?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

enum ProfileType {
  PERSONAL
  BUSINESS
}

enum ProfileVisibility {
  PUBLIC
  FRIENDS
  PRIVATE
}

enum PostVisibility {
  PUBLIC
  FRIENDS
  PRIVATE
  COMMUNITY_ONLY
}

enum PostLabel {
  DEFAULT
  MENCARI
  LOKASI
  PROFESI
  SEKOLAH
}

enum InteractionPrivacy {
  PUBLIC
  FRIENDS
  TURN_OFF
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
}

enum PostType {
  NORMAL
  SEARCHING
  OFFERING
  QUESTION
  POLL
  ANNOUNCEMENT
}

enum NotificationType {
  FOLLOW
  FRIEND_REQUEST
  FRIEND_ACCEPT
  FRIEND_NOW
  POST_LIKE
  POST_COMMENT
  COMMENT_REPLY
  POST_SHARE
}
