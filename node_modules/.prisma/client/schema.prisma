generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// 1. users --- Akun Pengguna
// ==========================================
model User {
  id                String    @id @default(uuid())
  username          String    @unique
  email             String    @unique
  phone             String?
  passwordHash      String
  status            String    @default("ACTIVE") // ACTIVE, SUSPENDED, DELETED
  resetOtpCode      String?   @db.VarChar(6)
  resetOtpExpiresAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relasi
  profile         Profile?
  profileSettings ProfileSettings?
  socialLinks     UserSocialLink[]
  posts           Post[]

  followers Follow[] @relation("UserFollowers")
  following Follow[] @relation("UserFollowing")

  friendshipsAsUser   Friendship[] @relation("FriendshipUser")
  friendshipsAsFriend Friendship[] @relation("FriendshipFriend")
  friendRequestsSent  Friendship[] @relation("FriendshipRequester")

  blocksSent     Block[] @relation("BlockUser")
  blocksReceived Block[] @relation("BlockBlockedUser")
}

model PendingUser {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String
  passwordHash String
  otpCode      String   @db.VarChar(6)
  createdAt    DateTime @default(now())
}

// ==========================================
// 2. profiles --- Informasi Utama Profile
// ==========================================
enum ProfileType {
  PERSONAL
  BUSINESS
}

model Profile {
  id          String      @id @default(uuid())
  userId      String      @unique
  displayName String
  bio         String?     @db.Text
  type        ProfileType @default(PERSONAL)
  avatarUrl   String?     @db.Text
  coverUrl    String?     @db.Text
  gender      String?
  birthDate   DateTime?
  locationId  String?
  websiteUrl  String?     @db.Text

  // Custom links from plan
  socialMedia String? @db.Text
  community   String? @db.Text
  groupChat   String? @db.Text

  displayNameChangeDates DateTime[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
}

// ==========================================
// 3. profile_settings --- Privasi & Pengaturan
// ==========================================
enum ProfileVisibility {
  PUBLIC
  FRIENDS
  PRIVATE
}

model ProfileSettings {
  userId             String            @id
  profileVisibility  ProfileVisibility @default(PUBLIC)
  showBirthDate      Boolean           @default(true)
  showLocation       Boolean           @default(true)
  allowFollow        Boolean           @default(true)
  allowFriendRequest Boolean           @default(true)
  searchable         Boolean           @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==========================================
// 4. user_social_links --- Link Sosial (Multiple)
// ==========================================
model UserSocialLink {
  id           String @id @default(uuid())
  userId       String
  platform     String
  url          String @db.Text
  displayOrder Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==========================================
// 5. locations --- Data Lokasi Terstruktur
// ==========================================
model Location {
  id       String  @id @default(uuid())
  country  String
  province String
  city     String
  district String?

  profiles Profile[]
}

// ==========================================
// 6. follows --- Relasi Follow
// ==========================================
model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

// ==========================================
// 7. friendships --- Relasi Pertemanan
// ==========================================
enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
}

model Friendship {
  id          String           @id @default(uuid())
  userId      String
  friendId    String
  requestedBy String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  acceptedAt  DateTime?

  user      User @relation("FriendshipUser", fields: [userId], references: [id], onDelete: Cascade)
  friend    User @relation("FriendshipFriend", fields: [friendId], references: [id], onDelete: Cascade)
  requester User @relation("FriendshipRequester", fields: [requestedBy], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
}

// ==========================================
// 8. blocks --- Blokir Pengguna
// ==========================================
model Block {
  id            String   @id @default(uuid())
  userId        String
  blockedUserId String
  createdAt     DateTime @default(now())

  user        User @relation("BlockUser", fields: [userId], references: [id], onDelete: Cascade)
  blockedUser User @relation("BlockBlockedUser", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@unique([userId, blockedUserId])
}

// ==========================================
// Existing Posts Model
// ==========================================
enum PostType {
  NORMAL
  SEARCHING
  OFFERING
  QUESTION
  POLL
  ANNOUNCEMENT
}

model Post {
  id        String   @id @default(uuid())
  content   String   @db.Text
  type      PostType @default(NORMAL)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
}
